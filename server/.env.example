# FinTrack AI — Server Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# The `.env` file is gitignored and should NEVER be committed.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# HTTP port for the Express server (default: 3001)
PORT=3001

# Google Gemini API Key (optional)
# Obtain from: https://aistudio.google.com/app/apikey
# If left blank, all AI features will operate in fallback/demo mode.
GEMINI_API_KEY=
