# FinTrack AI — Client Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored and should NEVER be committed.
#
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# Backend API URL
# Development: leave blank — Vite dev proxy handles /api routing to localhost:3001
# Production:  set this to your deployed backend URL (e.g. Railway)
#
# Example: VITE_API_URL=https://fintrack-api.up.railway.app/api
VITE_API_URL=
